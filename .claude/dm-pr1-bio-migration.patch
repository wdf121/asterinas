+
+        assert_eq!(children[0].sid_range(), &(Sid::new(10)..Sid::new(13)));
+        assert_eq!(children[1].sid_range(), &(Sid::new(13)..Sid::new(15)));
+        assert_eq!(children[2].sid_range(), &(Sid::new(15)..Sid::new(18)));
