diff --git a/myshell/dm_striped/run_raw_striped_bio_test.sh b/myshell/dm_striped/run_raw_striped_bio_test.sh
new file mode 100755
index 000000000..67f479052
--- /dev/null
+++ b/myshell/dm_striped/run_raw_striped_bio_test.sh
@@ -0,0 +1,122 @@
+#!/bin/bash
+
+# SPDX-License-Identifier: MPL-2.0
+
+set -euo pipefail
+
+if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
+    cat <<'EOF'
+Usage: myshell/dm_striped/run_raw_striped_bio_test.sh
+
+Runs a NixOS guest regression for raw dm_striped BIO split/remap.
+
+Optional environment variables:
+  DM_TEST_IMAGE              First backing test image path, default target/nixos/test.img
+  DM_TEST_IMAGE_2            Second backing test image path, default target/nixos/test2.img
+  DM_STRIPED_RAW_BIO_LOG     Host-side log path, default /tmp/dm-striped-raw-bio-test.log
+  GUEST_READY_TIMEOUT        Seconds to wait for guest root shell, default 120
+  RESET_DM_TEST_IMAGES       1 to delete test images before running, default 1
+EOF
+    exit 0
+fi
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+ASTERINAS_DIR=$(realpath "${SCRIPT_DIR}/../..")
+source "${SCRIPT_DIR}/../lib/dm_nixos_test.sh"
+
+TEST_ID=DM_STRIPED_RAW_BIO
+LOG=${DM_STRIPED_RAW_BIO_LOG:-/tmp/dm-striped-raw-bio-test.log}
+DM_TEST_IMAGE=${DM_TEST_IMAGE:-target/nixos/test.img}
+DM_TEST_IMAGE_2=${DM_TEST_IMAGE_2:-target/nixos/test2.img}
+GUEST_READY_TIMEOUT=${GUEST_READY_TIMEOUT:-120}
+RESET_DM_TEST_IMAGES=${RESET_DM_TEST_IMAGES:-1}
+
+cd "${ASTERINAS_DIR}"
+dm_prepare_nixos_test "${TEST_ID}"
+echo "HOST_INFO_${TEST_ID} disk1=${DM_TEST_IMAGE} serial=vdmtest"
+echo "HOST_INFO_${TEST_ID} disk2=${DM_TEST_IMAGE_2} serial=vdmtest2"
+
+GUEST_SCRIPT_FILE=$(mktemp /tmp/dm-striped-raw-bio-guest.XXXXXX)
+cat >"${GUEST_SCRIPT_FILE}" <<'GUEST_SCRIPT'
+stty -echo 2>/dev/null || true
+set -eu
+trap 'status=$?; echo TEST_FAIL_DM_STRIPED_RAW_BIO status=$status; sync; poweroff; exit $status' ERR
+
+devno() {
+    printf '%d:%d' "0x$(stat -c '%t' "$1")" "0x$(stat -c '%T' "$1")"
+}
+
+cleanup_dm() {
+    dmsetup remove dm_striped_raw >/dev/null 2>&1 || true
+}
+
+echo '=== STEP 1: check dm control device, striped target, and test disks ==='
+test -c /dev/mapper/control
+dmsetup targets | tee /tmp/striped-targets.txt
+grep -q '^striped' /tmp/striped-targets.txt
+TEST_DISK=$(aster-dm-disk-locator)
+TEST_DISK2=$(aster-dm-disk-locator vdmtest2)
+printf 'TEST_DISK=%s\nTEST_DISK2=%s\n' "$TEST_DISK" "$TEST_DISK2"
+test "$TEST_DISK" != "$TEST_DISK2"
+test -b "$TEST_DISK"
+test -b "$TEST_DISK2"
+DEV1=$(devno "$TEST_DISK")
+DEV2=$(devno "$TEST_DISK2")
+printf 'DEV1=%s\nDEV2=%s\n' "$DEV1" "$DEV2"
+echo CHECK_PASS_STRIPED_RAW_SETUP
+
+cleanup_dm
+
+echo '=== STEP 2: create a 2-way striped mapper with 4-sector chunks ==='
+dd if=/dev/zero of="$TEST_DISK" bs=8192 count=1 conv=fsync status=none
+dd if=/dev/zero of="$TEST_DISK2" bs=8192 count=1 conv=fsync status=none
+printf '0 16 striped 2 4 %s 0 %s 0\n' "$DEV1" "$DEV2" | dmsetup create dm_striped_raw
+
+DM_TABLE_EXPECTED="0 16 striped 2 4 $DEV1 0 $DEV2 0"
+echo 'DM_TABLE_STRIPED_RAW_BEGIN'
+dmsetup table dm_striped_raw | tee /tmp/striped-table.txt | sed 's/^/DM_TABLE_STRIPED_RAW /'
+echo 'DM_TABLE_STRIPED_RAW_END'
+grep -F -x -q "$DM_TABLE_EXPECTED" /tmp/striped-table.txt
+
+dmsetup status dm_striped_raw | tee /tmp/striped-status.txt
+grep -q 'striped' /tmp/striped-status.txt
+dmsetup deps dm_striped_raw | tee /tmp/striped-deps.txt
+grep -q '2 dependencies' /tmp/striped-deps.txt
+echo CHECK_PASS_STRIPED_RAW_TABLE_STATUS_DEPS
+
+echo '=== STEP 3: write an 8 KiB payload across four striped chunks ==='
+head -c 2048 /dev/zero | tr '\000' '\101' > /tmp/striped-chunk-a.bin
+head -c 2048 /dev/zero | tr '\000' '\102' > /tmp/striped-chunk-b.bin
+head -c 2048 /dev/zero | tr '\000' '\103' > /tmp/striped-chunk-c.bin
+head -c 2048 /dev/zero | tr '\000' '\104' > /tmp/striped-chunk-d.bin
+cat /tmp/striped-chunk-a.bin /tmp/striped-chunk-b.bin /tmp/striped-chunk-c.bin /tmp/striped-chunk-d.bin > /tmp/striped-payload.bin
+cat /tmp/striped-chunk-a.bin /tmp/striped-chunk-c.bin > /tmp/striped-expect-first.bin
+cat /tmp/striped-chunk-b.bin /tmp/striped-chunk-d.bin > /tmp/striped-expect-second.bin
+
+dd if=/tmp/striped-payload.bin of=/dev/mapper/dm_striped_raw bs=8192 count=1 conv=fsync status=none
+dd if=/dev/mapper/dm_striped_raw of=/tmp/striped-readback.bin bs=8192 count=1 status=none
+
+echo '=== CHECK 1: mapper readback md5 equals original payload ==='
+md5sum /tmp/striped-payload.bin /tmp/striped-readback.bin > /tmp/striped-readback.md5
+awk 'NR == 1 { expected = $1 } NR > 1 && $1 != expected { exit 1 }' /tmp/striped-readback.md5
+echo CHECK_PASS_STRIPED_RAW_MAPPER_READBACK_MD5
+
+echo '=== CHECK 2: backing disks contain interleaved stripe chunks ==='
+dd if="$TEST_DISK" of=/tmp/striped-first.bin bs=4096 count=1 status=none
+dd if="$TEST_DISK2" of=/tmp/striped-second.bin bs=4096 count=1 status=none
+md5sum /tmp/striped-expect-first.bin /tmp/striped-first.bin > /tmp/striped-first.md5
+awk 'NR == 1 { expected = $1 } NR > 1 && $1 != expected { exit 1 }' /tmp/striped-first.md5
+md5sum /tmp/striped-expect-second.bin /tmp/striped-second.bin > /tmp/striped-second.md5
+awk 'NR == 1 { expected = $1 } NR > 1 && $1 != expected { exit 1 }' /tmp/striped-second.md5
+echo CHECK_PASS_STRIPED_RAW_BACKING_DISTRIBUTION_MD5
+
+echo '=== STEP 4: cleanup ==='
+dmsetup remove dm_striped_raw
+sync
+
+echo TEST_PASS_DM_STRIPED_RAW_BIO
+poweroff
+GUEST_SCRIPT
+
+SUMMARY_INCLUDE='TEST_|CHECK_PASS_|=== STEP|=== CHECK|TEST_DISK=|TEST_DISK2=|DEV1=|DEV2=|DM_TABLE_STRIPED_RAW|striped|dependencies|Command failed|Kernel panic|panicked|records in|records out|bytes .* copied'
+dm_run_single_guest_test "${TEST_ID}" "${GUEST_SCRIPT_FILE}" TEST_PASS_DM_STRIPED_RAW_BIO "${SUMMARY_INCLUDE}"
