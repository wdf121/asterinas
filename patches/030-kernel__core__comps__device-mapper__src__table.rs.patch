+    fn striped_dm_target(
+        logical_start: u64,
+        length: u64,
+        params: &str,
+        backings: &[Arc<RecordingBlockDevice>],
+    ) -> DmTarget {
+        DmTarget::Striped(
+            StripedTarget::new(
+                Sid::new(logical_start),
+                length,
+                StripedTargetParams::parse(params).unwrap(),
+                backings
+                    .iter()
+                    .map(|backing| {
+                        BlockDeviceLease::new_untracked(backing.clone() as Arc<dyn BlockDevice>)
+                    })
+                    .collect(),
+            )
+            .unwrap(),
+        )
+    }
