+impl Drop for PendingBlockDeviceRegistration {
+    fn drop(&mut self) {
+        let mut registry = DEVICE_REGISTRY.lock();
+        let id = self.id().to_raw();
+        let Some(current) = registry.get(&id) else {
+            return;
