+
+        assert!(lookup(id).is_none());
+        assert!(lookup_lease(id).is_none());
+        commit_registration(&pending).unwrap();
+        assert!(lookup(id).is_some());
+        assert!(unregister(id).is_ok());
+    }
+
+    #[ktest]
