diff --git a/myshell/dm_linear/run_linear_full_flow_test.sh b/myshell/dm_linear/run_linear_full_flow_test.sh
new file mode 100755
index 000000000..c7caf19a3
--- /dev/null
+++ b/myshell/dm_linear/run_linear_full_flow_test.sh
@@ -0,0 +1,186 @@
+#!/bin/bash
+
+# SPDX-License-Identifier: MPL-2.0
+
+set -euo pipefail
+
+if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
+    cat <<'EOF'
+Usage: myshell/dm_linear/run_linear_full_flow_test.sh
+
+Runs a single NixOS guest end-to-end regression for the linear Device Mapper path.
+
+Optional environment variables:
+  DM_TEST_IMAGE              First backing test image path, default target/nixos/test.img
+  DM_TEST_IMAGE_2            Second backing test image path, default target/nixos/test2.img
+  DM_LINEAR_FULL_FLOW_LOG    Host-side log path, default /tmp/dm-linear-full-flow-test.log
+  GUEST_READY_TIMEOUT        Seconds to wait for guest root shell, default 120
+  RESET_DM_TEST_IMAGES       1 to delete test images before running, default 1
+EOF
+    exit 0
+fi
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+ASTERINAS_DIR=$(realpath "${SCRIPT_DIR}/../..")
+source "${SCRIPT_DIR}/../lib/dm_nixos_test.sh"
+
+TEST_ID=DM_LINEAR_FULL_FLOW
+LOG=${DM_LINEAR_FULL_FLOW_LOG:-/tmp/dm-linear-full-flow-test.log}
+DM_TEST_IMAGE=${DM_TEST_IMAGE:-target/nixos/test.img}
+DM_TEST_IMAGE_2=${DM_TEST_IMAGE_2:-target/nixos/test2.img}
+GUEST_READY_TIMEOUT=${GUEST_READY_TIMEOUT:-120}
+RESET_DM_TEST_IMAGES=${RESET_DM_TEST_IMAGES:-1}
+
+cd "${ASTERINAS_DIR}"
+dm_prepare_nixos_test "${TEST_ID}"
+echo "HOST_INFO_${TEST_ID} disk1=${DM_TEST_IMAGE} serial=vdmtest"
+echo "HOST_INFO_${TEST_ID} disk2=${DM_TEST_IMAGE_2} serial=vdmtest2"
+
+GUEST_SCRIPT_FILE=$(mktemp /tmp/dm-linear-full-flow-guest.XXXXXX)
+cat >"${GUEST_SCRIPT_FILE}" <<'GUEST_SCRIPT'
+stty -echo 2>/dev/null || true
+set -eu
+trap 'status=$?; echo TEST_FAIL_DM_LINEAR_FULL_FLOW status=$status; sync; poweroff; exit $status' ERR
+
+LVM_CONFIG='activation { udev_rules=0 }'
+
+devno() {
+    printf '%d:%d' "0x$(stat -c '%t' "$1")" "0x$(stat -c '%T' "$1")"
+}
+
+cleanup_dm() {
+    dmsetup remove dm_linear_full_control >/dev/null 2>&1 || true
+    dmsetup remove dm_linear_full_renamed >/dev/null 2>&1 || true
+    dmsetup remove dm_linear_full_raw >/dev/null 2>&1 || true
+}
+
+cleanup_lvm() {
+    umount /mnt/dmlinear >/dev/null 2>&1 || true
+    lvremove --config "$LVM_CONFIG" -y full_vg/full_lv >/dev/null 2>&1 || true
+    vgremove --config "$LVM_CONFIG" -y full_vg >/dev/null 2>&1 || true
+    pvremove -y "$TEST_DISK" "$TEST_DISK2" >/dev/null 2>&1 || true
+}
+
+echo '=== STEP 1: check dm control device, target versions, and test disks ==='
+test -c /dev/mapper/control
+dmsetup version
+dmsetup targets | tee /tmp/linear-full-targets.txt
+grep -q '^linear' /tmp/linear-full-targets.txt
+TEST_DISK=$(aster-dm-disk-locator)
+TEST_DISK2=$(aster-dm-disk-locator vdmtest2)
+printf 'TEST_DISK=%s\nTEST_DISK2=%s\n' "$TEST_DISK" "$TEST_DISK2"
+test "$TEST_DISK" != "$TEST_DISK2"
+test -b "$TEST_DISK"
+test -b "$TEST_DISK2"
+DEV1=$(devno "$TEST_DISK")
+DEV2=$(devno "$TEST_DISK2")
+printf 'DEV1=%s\nDEV2=%s\n' "$DEV1" "$DEV2"
+echo CHECK_PASS_LINEAR_FULL_SETUP
+
+cleanup_dm
+cleanup_lvm
+
+echo '=== STEP 2: exercise control ABI on a simple linear mapper ==='
+printf '0 8 linear %s 0\n' "$DEV1" | dmsetup create dm_linear_full_control
+dmsetup table dm_linear_full_control | tee /tmp/linear-full-control-table.txt
+grep -F -x -q "0 8 linear $DEV1 0" /tmp/linear-full-control-table.txt
+dmsetup status dm_linear_full_control | tee /tmp/linear-full-control-status.txt
+dmsetup deps dm_linear_full_control | tee /tmp/linear-full-control-deps.txt
+grep -q 'linear' /tmp/linear-full-control-status.txt
+grep -q '1 dependencies' /tmp/linear-full-control-deps.txt
+dmsetup rename dm_linear_full_control dm_linear_full_renamed
+dmsetup suspend --noflush dm_linear_full_renamed
+dmsetup info dm_linear_full_renamed | tee /tmp/linear-full-suspended.txt
+grep -q 'State:.*SUSPENDED' /tmp/linear-full-suspended.txt
+dmsetup resume --noflush dm_linear_full_renamed
+dmsetup info dm_linear_full_renamed | tee /tmp/linear-full-resumed.txt
+grep -q 'State:.*ACTIVE' /tmp/linear-full-resumed.txt
+dmsetup remove dm_linear_full_renamed
+echo CHECK_PASS_LINEAR_FULL_CONTROL
+
+echo '=== STEP 3: issue one 4 KiB BIO across two linear targets ==='
+dd if=/dev/zero of="$TEST_DISK" bs=4096 count=1 conv=fsync status=none
+dd if=/dev/zero of="$TEST_DISK2" bs=4096 count=1 conv=fsync status=none
+printf '0 4 linear %s 0\n4 4 linear %s 0\n' "$DEV1" "$DEV2" | dmsetup create dm_linear_full_raw
+dmsetup table dm_linear_full_raw | tee /tmp/linear-full-raw-table.txt
+test "$(wc -l < /tmp/linear-full-raw-table.txt)" -eq 2
+awk '{ sum += $2 } END { exit !(sum == 8) }' /tmp/linear-full-raw-table.txt
+head -c 4096 /dev/zero | tr '\000' '\132' > /tmp/linear-full-pattern.bin
+head -c 2048 /tmp/linear-full-pattern.bin > /tmp/linear-full-half.bin
+dd if=/tmp/linear-full-pattern.bin of=/dev/mapper/dm_linear_full_raw bs=4096 count=1 conv=fsync status=none
+dd if=/dev/mapper/dm_linear_full_raw of=/tmp/linear-full-readback.bin bs=4096 count=1 status=none
+md5sum /tmp/linear-full-pattern.bin /tmp/linear-full-readback.bin > /tmp/linear-full-readback.md5
+awk 'NR == 1 { expected = $1 } NR > 1 && $1 != expected { exit 1 }' /tmp/linear-full-readback.md5
+dd if="$TEST_DISK" of=/tmp/linear-full-first.bin bs=2048 count=1 status=none
+dd if="$TEST_DISK2" of=/tmp/linear-full-second.bin bs=2048 count=1 status=none
+md5sum /tmp/linear-full-half.bin /tmp/linear-full-first.bin /tmp/linear-full-second.bin > /tmp/linear-full-backing.md5
+awk 'NR == 1 { expected = $1 } NR > 1 && $1 != expected { exit 1 }' /tmp/linear-full-backing.md5
+dmsetup remove dm_linear_full_raw
+echo CHECK_PASS_LINEAR_FULL_RAW_BIO
+
+echo '=== STEP 4: create a linear LV, mount it, and write data ==='
+pvcreate "$TEST_DISK" "$TEST_DISK2"
+vgcreate full_vg "$TEST_DISK" "$TEST_DISK2"
+lvcreate --config "$LVM_CONFIG" --type linear -L 400M -n full_lv full_vg "$TEST_DISK"
+lvs --segments -o lv_name,seg_start,seg_size,devices full_vg/full_lv
+dmsetup table full_vg-full_lv | tee /tmp/linear-full-initial-table.txt
+test "$(wc -l < /tmp/linear-full-initial-table.txt)" -eq 1
+awk '{ sum += $2 } END { exit !(sum == 819200) }' /tmp/linear-full-initial-table.txt
+awk '{ if ($3 != "linear") exit 1 }' /tmp/linear-full-initial-table.txt
+MAPPER_DEVICE=/dev/mapper/full_vg-full_lv
+mkfs.ext2 -F -b 4096 "$MAPPER_DEVICE"
+mkdir -p /mnt/dmlinear
+mount -t ext2 "$MAPPER_DEVICE" /mnt/dmlinear
+printf 'hello linear full flow\n' > /mnt/dmlinear/hello.txt
+cat /mnt/dmlinear/hello.txt
+sync
+echo CHECK_PASS_LINEAR_FULL_CREATE_AND_WRITE
+
+echo '=== STEP 5: extend LV across the second PV and grow ext2 offline ==='
+lvextend --config "$LVM_CONFIG" -L 700M full_vg/full_lv "$TEST_DISK2"
+dmsetup table full_vg-full_lv | tee /tmp/linear-full-extended-table.txt
+test "$(wc -l < /tmp/linear-full-extended-table.txt)" -ge 2
+awk '{ sum += $2 } END { exit !(sum == 1433600) }' /tmp/linear-full-extended-table.txt
+awk '{ if ($3 != "linear") exit 1 }' /tmp/linear-full-extended-table.txt
+awk '{ dev[$4] = 1 } END { count = 0; for (d in dev) count++; exit !(count >= 2) }' /tmp/linear-full-extended-table.txt
+cat /mnt/dmlinear/hello.txt
+umount /mnt/dmlinear
+e2fsck -f -y "$MAPPER_DEVICE"
+resize2fs "$MAPPER_DEVICE"
+e2fsck -f -y "$MAPPER_DEVICE"
+mount -t ext2 "$MAPPER_DEVICE" /mnt/dmlinear
+printf 'after linear grow\n' > /mnt/dmlinear/grow.txt
+cat /mnt/dmlinear/hello.txt
+cat /mnt/dmlinear/grow.txt
+sync
+echo CHECK_PASS_LINEAR_FULL_EXTEND
+
+echo '=== STEP 6: shrink ext2 and LV back to one linear target ==='
+umount /mnt/dmlinear
+e2fsck -f -y "$MAPPER_DEVICE"
+resize2fs "$MAPPER_DEVICE" 300M
+e2fsck -f -y "$MAPPER_DEVICE"
+lvreduce --config "$LVM_CONFIG" -y -L 300M full_vg/full_lv
+dmsetup table full_vg-full_lv | tee /tmp/linear-full-shrunk-table.txt
+test "$(wc -l < /tmp/linear-full-shrunk-table.txt)" -eq 1
+awk '{ sum += $2 } END { exit !(sum == 614400) }' /tmp/linear-full-shrunk-table.txt
+awk '{ if ($3 != "linear") exit 1 }' /tmp/linear-full-shrunk-table.txt
+mount -t ext2 "$MAPPER_DEVICE" /mnt/dmlinear
+cat /mnt/dmlinear/hello.txt
+cat /mnt/dmlinear/grow.txt
+sync
+echo CHECK_PASS_LINEAR_FULL_SHRINK
+
+echo '=== STEP 7: cleanup all linear full-flow state ==='
+umount /mnt/dmlinear
+lvremove --config "$LVM_CONFIG" -y full_vg/full_lv
+vgremove --config "$LVM_CONFIG" -y full_vg
+pvremove -y "$TEST_DISK" "$TEST_DISK2"
+cleanup_dm
+sync
+echo TEST_PASS_DM_LINEAR_FULL_FLOW
+poweroff
+GUEST_SCRIPT
+
+SUMMARY_INCLUDE='TEST_|CHECK_PASS_|=== STEP|=== CHECK|TEST_DISK=|TEST_DISK2=|DEV1=|DEV2=|linear full|dm_linear_full|full_vg|full_lv|linear|hello linear|after linear|dependencies|State:|Command failed|Kernel panic|panicked|records in|records out|bytes .* copied'
+dm_run_single_guest_test "${TEST_ID}" "${GUEST_SCRIPT_FILE}" TEST_PASS_DM_LINEAR_FULL_FLOW "${SUMMARY_INCLUDE}"
